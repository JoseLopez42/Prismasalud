Table afiliacion [note: 'Registra la afiliación de un usuario o beneficiario a una EPS, régimen, empresa y estado, con su fecha.'] {
  id_afiliacion bigint unsigned [pk, not null, increment]
  fecha_afiliacion date [not null]
  id_tipo_afiliacion bigint unsigned [not null]
  nit_eps varchar(20)
  nit_empresa varchar(30)
  nombre_empresa varchar(150)
  cc_usuario bigint unsigned [not null]
  id_estado bigint unsigned [not null]
  cc_afiliado bigint unsigned [not null]
  created_at datetime
  updated_at datetime
  id_parentesco bigint unsigned
}

Table auditoria_clinica [note: 'Registro inmutable de cambios y bajas de historia clínica para trazabilidad sanitaria (Ley 2015 de 2020).'] {
  id bigint unsigned [pk, not null, increment]
  tabla varchar(64) [not null]
  id_registro bigint unsigned [not null]
  accion enum('UPDATE','DELETE') [not null]
  valores_antes longtext [not null]
  usuario_bd varchar(100) [not null]
  usuario_app bigint unsigned
  fecha datetime [not null]
}

Table beneficiarios [note: 'Ficha demográfica y de seguridad social de cotizantes y beneficiarios, con datos sensibles cifrados.'] {
  cc_afiliado bigint unsigned [pk, not null]
  tipo_persona varchar(15) [not null]
  cc_cotizante bigint unsigned
  nit_eps varchar(20)
  id_tipo_documento bigint unsigned
