  nombres varchar(100) [not null]
  apellidos varchar(100) [not null]
  telefono text
  direccion text [not null]
  correo varchar(100) [not null]
  fecha_nacimiento date
  created_at datetime
  updated_at datetime
  id_genero bigint unsigned
  id_estado_civil bigint unsigned
  id_nivel_educativo bigint unsigned
  id_ocupacion bigint unsigned
  id_pais_nacionalidad bigint unsigned
  id_pais_nacimiento bigint unsigned
  id_pais_expedicion bigint unsigned
  id_zona_residencia bigint unsigned
  id_parentesco bigint unsigned
