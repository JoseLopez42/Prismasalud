Ref: afiliacion.cc_afiliado > beneficiarios.cc_afiliado
Ref: afiliacion.cc_usuario > usuarios.cedula
Ref: afiliacion.id_estado > estado.id_estado
Ref: afiliacion.id_parentesco > parentescos.id_parentesco
Ref: afiliacion.id_tipo_afiliacion > regimen.id_regimen
Ref: afiliacion.nit_eps > eps.nit_eps
Ref: beneficiarios.cc_cotizante > beneficiarios.cc_afiliado
Ref: beneficiarios.id_estado_civil > estados_civiles.id_estado_civil
Ref: beneficiarios.id_genero > generos.id_genero
Ref: beneficiarios.id_nivel_educativo > niveles_educativos.id_nivel_educativo
Ref: beneficiarios.id_ocupacion > ocupaciones.id_ocupacion
Ref: beneficiarios.id_pais_expedicion > paises.id_pais
Ref: beneficiarios.id_pais_nacimiento > paises.id_pais
Ref: beneficiarios.id_pais_nacionalidad > paises.id_pais
Ref: beneficiarios.id_parentesco > parentescos.id_parentesco
Ref: beneficiarios.id_tipo_documento > tipo_documento.id_tipo_documento
Ref: beneficiarios.id_zona_residencia > zonas_residencia.id_zona_residencia
Ref: beneficiarios.nit_eps > eps.nit_eps
Ref: catalogo_procedimiento.id_tipo_procedimiento > tipo_procedimiento.id
Ref: cita.cedula_medico > medico.cedula
Ref: cita.cedula_usuario > usuarios.cedula
Ref: cita.empresa_id > empresas.id
Ref: cita.id_consultorio > consultorio.id
Ref: cita.id_estado_cita > estado_cita.id
Ref: cita.id_tipo_cita > tipo_cita.id
Ref: ciudades.id_departamento > departamentos.id_departamento
Ref: consultorio.id_sede > sedes.id_sede
Ref: detalle_afiliado_afiliacion.cc_afiliado > beneficiarios.cc_afiliado
Ref: detalle_afiliado_afiliacion.id_afiliacion > afiliacion.id_afiliacion
Ref: detalle_afiliado_afiliacion.id_estado > estado.id_estado
Ref: detalle_procedimiento.id_procedimiento > procedimiento.id
Ref: diagnostico.cedula_medico > medico.cedula
Ref: diagnostico.cedula_paciente > usuarios.cedula
Ref: diagnostico.empresa_id > empresas.id
Ref: diagnostico.id_historia_clinica > historia_clinica.id
Ref: empresas.licencia_id > licencias.id
Ref: empresas.usuario_cedula > usuarios.cedula
Ref: enfermedad.cedula_medico > medico.cedula
Ref: enfermedad.cedula_paciente > usuarios.cedula
